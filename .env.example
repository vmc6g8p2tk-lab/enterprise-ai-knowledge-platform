POSTGRES_USER=knowledge
POSTGRES_PASSWORD=change-me-for-local-development
POSTGRES_DB=knowledge
DATABASE_URL=postgresql://knowledge:change-me-for-local-development@postgres:5432/knowledge
AI_SERVICE_URL=http://ai-service:8000
UPLOAD_DIR=/data/uploads
EMBEDDING_PROVIDER=hash
ANSWER_PROVIDER=extractive
# For real model calls, set both providers to openai and supply your own key.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o-mini
EMBEDDING_DIMENSIONS=1536
EMBEDDING_BATCH_SIZE=32
MODEL_TIMEOUT_SECONDS=30
MODEL_MAX_RETRIES=2
# Optional for reproducible local-model calls; the local Compose overlay sets 0/42.
# MODEL_TEMPERATURE=0
# MODEL_SEED=42
RAG_DEBUG=1
# Generate separate random 32-byte-or-longer values; never commit the real .env.
JWT_SECRET=
INTERNAL_SERVICE_TOKEN=
